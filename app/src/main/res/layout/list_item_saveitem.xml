<?xml version="1.0" encoding="utf-8"?>
<!--
  저장 목록 한 줄.

  예전에는 배경·배지·삭제 테두리가 한 장의 그림(line2.jpg)에 함께 그려져 있었다.
  그림을 줄 크기에 맞춰 늘리다 보니 안의 원이 타원으로 찌그러졌고, 그림 위에 글자를
  얹느라 위치도 어긋났다. 배경은 도형으로, 배지와 삭제 버튼은 정사각형 뷰로 바꿨다.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_save_row"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 호선 배지. 크기를 정사각형으로 못 박아 항상 정확한 원이 된다.
         색은 SearchAdapter 가 노선색으로 칠한다. -->
    <ImageView
        android:id="@+id/img_line_badge"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_subway_line_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_on_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/img_line_badge"
        app:layout_constraintEnd_toEndOf="@+id/img_line_badge"
        app:layout_constraintStart_toStartOf="@+id/img_line_badge"
        app:layout_constraintTop_toTopOf="@+id/img_line_badge" />

    <TextView
        android:id="@+id/txt_subway_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/btn_delete"
        app:layout_constraintStart_toEndOf="@+id/img_line_badge"
        app:layout_constraintTop_toTopOf="@+id/img_line_badge" />

    <TextView
        android:id="@+id/txt_subway_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/txt_subway_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_subway_name" />

    <TextView
        android:id="@+id/txt_subway_direction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/txt_subway_days"
        app:layout_constraintTop_toTopOf="@+id/txt_subway_days" />

    <ImageView
        android:id="@+id/btn_delete"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_stroke"
        android:padding="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_delete_35dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
