local.properties
# 자격 증명
*.pem
*.p12
*.p8
secrets.properties

# ── 빌드 산출물 ────────────────────────────────────────────
build/
/captures
.externalNativeBuild
.cxx
gen/
out/
release/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof
lint-results*.html
